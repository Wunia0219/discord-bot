{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jokers-circus",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/__ops/*", "/healthz", "/readyz", "/assets/*.mp3"]},
  "durable_objects": {"bindings": [{"name": "CIRCUS_PROJECT", "class_name": "CircusProject"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CircusProject"]}],
  "vars": {"CLOUD_PLAN": "paid", "APP_ENV": "test"},
  "observability": {"enabled": false}
}
