# Separate Worker secrets; leave disabled until an operations destination is selected.
# Never copy the game's admin token, encryption key, Google credentials or highlights webhook.
MONITOR_ENABLED=false
MONITORED_ORIGIN=https://jokers-circus.YOUR-SUBDOMAIN.workers.dev
# A NEW read-only token, stored as CLOUD_MONITOR_TOKEN on the GAME Worker
# and MONITORED_TOKEN on the MONITOR Worker. Use 32 random bytes (64 hex).
MONITORED_TOKEN=REPLACE_WITH_NEW_READ_ONLY_64_HEX_SECRET
# MONITOR_WEBHOOK_URL is a separate Discord operations webhook Secret.
# No webhook is configured or contacted by this example.
