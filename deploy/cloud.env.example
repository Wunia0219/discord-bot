# Private local operator settings. Copy to .env.cloud.local; never use VITE_ here.
CLOUD_ORIGIN=https://jokers-circus.YOUR-SUBDOMAIN.workers.dev
CLOUD_ADMIN_TOKEN=REPLACE_WITH_NEW_64_HEX_SECRET
# Optional NEW read-only monitor token for status/health. Never reuse the admin token.
# CLOUD_MONITOR_TOKEN=REPLACE_WITH_NEW_READ_ONLY_64_HEX_SECRET
# Store the separate encryption key as a Cloudflare secret and in a protected
# recovery location. Never include it in a downloaded backup or commit it.
# CLOUD_ENCRYPTION_KEY is configured via Wrangler secrets, not this CLI.
