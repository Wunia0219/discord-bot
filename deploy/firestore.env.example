# Local Node + Firestore Standard (default) database. Keep real secrets outside Git.
# Copy to .env.firestore.local after creating the Firebase database and server key.
WALLET_ENABLED=true
WALLET_BACKEND=firestore
APP_ENV=test
HOST=127.0.0.1
PORT=4192
LOCAL_WALLET_TEST=false
DISCORD_CLIENT_ID=1561284960986599626
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=b46c60cd5caf77520794fab64bb6de7036e0c1dc91aaa0038b1f9c3ea8e8f25f
ALLOWED_GUILD_IDS=
CHIP_ADMIN_ROLE_IDS=
# Days 1-7; consecutive Taipei calendar days, then repeat.
WEEKLY_CHECKIN_REWARDS=100,200,300,400,500,600,700
ADMIN_GRANT_MAX=100000
ADMIN_DAILY_MAX=1000000
FIRESTORE_PROJECT_ID=slot-game-203db
FIRESTORE_NAMESPACE=jokers-circus-test
# 1 keeps the existing format. Migrate to a NEW namespace before selecting 2.
FIRESTORE_SCHEMA_VERSION=1
# Keep false until the actual project, production-mode rules and server key are ready.
FIRESTORE_LIVE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
# One persistent allowance file shared by ALL local backends using this project.
FIRESTORE_QUOTA_PATH=data/firestore-usage-slot-game-203db.sqlite
FIRESTORE_READ_BUDGET=40000
FIRESTORE_WRITE_BUDGET=15000
FIRESTORE_EGRESS_MB=128
FIRESTORE_STORAGE_MB=128
# Leave empty for cloud access; emulator tests set a demo project automatically.
FIRESTORE_EMULATOR_HOST=
# Local Firestore logical backups. These do not enable Firebase native backups or billing.
OPERATIONS_ENABLED=true
BACKUP_DIRECTORY=backups
FIRESTORE_BACKUP_INTERVAL_MINUTES=1440
FIRESTORE_MONITOR_INTERVAL_SECONDS=600
FIRESTORE_MAINTENANCE_READ_BUDGET=6000
FIRESTORE_MAINTENANCE_EGRESS_MB=32
# Optional audited SQLite migration snapshot matching remote meta.importFingerprint.
# Required to bootstrap pre-upgrade administrative entries without operation links.
FIRESTORE_BACKUP_BASELINE=
BACKUP_RETENTION_DAYS=7
BACKUP_KEEP_MIN=3
BACKUP_MAX_COUNT=7
BACKUP_MAX_TOTAL_MB=256
DISK_MIN_FREE_MB=256
# Optional dedicated Discord text-channel webhook. Never enable in fixture QA.
DISCORD_HIGHLIGHTS_GUILD_ID=
DISCORD_HIGHLIGHTS_WEBHOOK_URL=
# Delivery shares the project allowance and also has these durable sub-limits.
# These are conservative reservation units, NOT extra Google free quota.
FIRESTORE_HIGHLIGHTS_READ_BUDGET=3000
FIRESTORE_HIGHLIGHTS_WRITE_BUDGET=1000
FIRESTORE_HIGHLIGHTS_EGRESS_MB=8
