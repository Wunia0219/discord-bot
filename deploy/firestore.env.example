# Local Node + Firestore Standard (default) database. Keep real secrets outside Git.
# Copy to .env.firestore.local after creating the Firebase database and server key.
WALLET_ENABLED=true
WALLET_BACKEND=firestore
APP_ENV=test
HOST=127.0.0.1
PORT=4192
LOCAL_WALLET_TEST=false
DISCORD_CLIENT_ID=1561284960986599626
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=b46c60cd5caf77520794fab64bb6de7036e0c1dc91aaa0038b1f9c3ea8e8f25f
ALLOWED_GUILD_IDS=
CHIP_ADMIN_ROLE_IDS=
DAILY_CHIPS=500
ADMIN_GRANT_MAX=100000
ADMIN_DAILY_MAX=1000000
FIRESTORE_PROJECT_ID=slot-game-203db
FIRESTORE_NAMESPACE=jokers-circus-test
# Keep false until the actual project, production-mode rules and server key are ready.
FIRESTORE_LIVE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
# One persistent allowance file shared by ALL local backends using this project.
FIRESTORE_QUOTA_PATH=data/firestore-usage-slot-game-203db.sqlite
FIRESTORE_READ_BUDGET=40000
FIRESTORE_WRITE_BUDGET=15000
FIRESTORE_EGRESS_MB=128
FIRESTORE_STORAGE_MB=128
# Leave empty for cloud access; emulator tests set a demo project automatically.
FIRESTORE_EMULATOR_HOST=
