# Copy to .env.backend.local for local backend development on the backend branch.
# Keep this file's credentials empty. The .local file is ignored by Git.
DISCORD_CLIENT_ID=1561284960986599626
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=b46c60cd5caf77520794fab64bb6de7036e0c1dc91aaa0038b1f9c3ea8e8f25f
WALLET_ENABLED=true
APP_ENV=test
ALLOWED_GUILD_IDS=
CHIP_ADMIN_ROLE_IDS=
DAILY_CHIPS=500
ADMIN_GRANT_MAX=100000
ADMIN_DAILY_MAX=1000000
DATABASE_PATH=data/backend.sqlite
BACKUP_DIRECTORY=backups/backend
# Runs while this backend process is alive. Manual backups are never pruned.
OPERATIONS_ENABLED=true
BACKUP_INTERVAL_MINUTES=360
BACKUP_RETENTION_DAYS=7
BACKUP_KEEP_MIN=3
BACKUP_MAX_COUNT=28
BACKUP_MAX_TOTAL_MB=256
MONITOR_INTERVAL_SECONDS=300
DISK_MIN_FREE_MB=256
HOST=127.0.0.1
PORT=4189
# Set true only for the loopback-only test account at /?wallet=local.
# Discord OAuth and interactions are disabled in this mode. Never expose it via a tunnel.
LOCAL_WALLET_TEST=false
# Only set these to intentionally test announcements in a dedicated channel.
DISCORD_HIGHLIGHTS_GUILD_ID=
DISCORD_HIGHLIGHTS_WEBHOOK_URL=
