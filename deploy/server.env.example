# Supply these as host environment variables/secrets. Never commit real credentials.
DISCORD_CLIENT_ID=1561284960986599626
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=b46c60cd5caf77520794fab64bb6de7036e0c1dc91aaa0038b1f9c3ea8e8f25f
# Optional: a webhook created in a dedicated highlights channel. Keep it secret.
# For a single allowed guild the guild ID may be omitted. Multiple allowed guilds
# require an explicit ID; this webhook can only receive that guild's results.
DISCORD_HIGHLIGHTS_GUILD_ID=
DISCORD_HIGHLIGHTS_WEBHOOK_URL=
APP_ENV=production
WALLET_ENABLED=true
# Replace with your friend's server ID. Empty values deliberately fail startup.
ALLOWED_GUILD_IDS=
CHIP_ADMIN_ROLE_IDS=
# Days 1-7; consecutive Taipei calendar days, then repeat.
WEEKLY_CHECKIN_REWARDS=500,500,1000,1000,1000,2000,4000
ADMIN_GRANT_MAX=100000
ADMIN_DAILY_MAX=1000000
DATABASE_PATH=/app/data/production.sqlite
BACKUP_DIRECTORY=/app/backups
# Local SQLite operations only; no cloud uploads or paid services.
OPERATIONS_ENABLED=true
BACKUP_INTERVAL_MINUTES=360
BACKUP_RETENTION_DAYS=7
BACKUP_KEEP_MIN=3
BACKUP_MAX_COUNT=28
BACKUP_MAX_TOTAL_MB=256
MONITOR_INTERVAL_SECONDS=300
DISK_MIN_FREE_MB=256
HOST=0.0.0.0
PORT=4188
