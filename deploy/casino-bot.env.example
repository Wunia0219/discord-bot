# Cloudflare Worker variables. Feature remains off until identity/channel checks pass.
DISCORD_CASINO_ENABLED=false
DISCORD_CASINO_GUILD_ID=YOUR_GUILD_ID
DISCORD_CASINO_CHANNEL_ID=YOUR_TEXT_CHANNEL_ID
# Existing application ID is reused. Invite that application's bot with
# bot + applications.commands scopes and View Channel, Send Messages, Embed Links.
# Store DISCORD_BOT_TOKEN only as a Worker Secret / private operator credential.
# Do not put it in VITE_ variables, this template, logs, or source control.
# DISCORD_HIGHLIGHTS_WEBHOOK_URL must be empty when casino bot mode is enabled.
