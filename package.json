{
  "name": "luna-arcade-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4187 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4187 --strictPort",
    "activity:serve": "npm run build && vite preview --host 127.0.0.1 --port 4188 --strictPort",
    "test": "node --test tests/*.test.js",
    "assets:webp": "python scripts/optimize-images.py",
    "verify:math": "node scripts/verify-math.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@pixi-spine/base": "4.0.6",
    "@pixi-spine/runtime-3.8": "4.0.6",
    "@pixi/core": "7.4.3",
    "pixi.js": "^8.22.0",
    "vite": "^7.3.7"
  }
}
