{
  "name": "luna-arcade-preview",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/security/patch-discord-sdk.js",
    "dev": "vite --host 127.0.0.1 --port 4187 --strictPort",
    "build": "vite build",
    "audio:preview": "node scripts/audio/render-previews.js",
    "preview": "vite preview --host 127.0.0.1 --port 4187 --strictPort",
    "activity:serve": "npm run build && npm run activity:server",
    "activity:server": "node --env-file=.env.server.local server/index.js",
    "commands:register": "node --env-file=.env.server.local scripts/admin/register-commands.js",
    "activity:configure-launch": "node --env-file=.env.server.local scripts/admin/configure-launch.js",
    "discord:check": "node --env-file=.env.server.local scripts/admin/check-discord.js",
    "db:backup": "node --env-file=.env.server.local scripts/admin/backup-db.js",
    "db:status": "node --env-file=.env.server.local scripts/admin/operations-status.js",
    "backup:portable": "node scripts/admin/portable-backup.js",
    "backend:dev": "node --watch --env-file=.env.backend.local server/index.js",
    "backend:start": "node --env-file=.env.backend.local server/index.js",
    "backend:init": "node --env-file=.env.backend.local scripts/admin/init-db.js",
    "backend:check": "node --env-file=.env.backend.local scripts/admin/check-db.js",
    "backend:backup": "node --env-file=.env.backend.local scripts/admin/backup-db.js",
    "backend:status": "node --env-file=.env.backend.local scripts/admin/operations-status.js",
    "backend:restore": "node --env-file=.env.backend.local scripts/admin/restore-db.js",
    "firestore:start": "node --env-file=.env.firestore.local server/index.js",
    "firestore:status": "node --env-file=.env.firestore.local scripts/admin/firestore-status.js",
    "firestore:backup": "node --env-file=.env.server.local scripts/admin/backup-firestore.js",
    "firestore:operations": "node --env-file=.env.server.local scripts/admin/operations-status.js",
    "firestore:migrate": "node --env-file=.env.firestore.local scripts/admin/import-firestore.js",
    "firestore:emulator:setup": "node scripts/admin/setup-firestore-emulator.js",
    "test:firestore": "node scripts/admin/test-firestore.js",
    "test": "node --test tests/*.test.js",
    "test:bot": "node --test tests/bot-interactions.test.js tests/commands.test.js tests/entry-point.test.js tests/highlights.test.js tests/activity-server.test.js tests/wallet.test.js tests/wallet-service.test.js tests/database.test.js tests/database-audit.test.js tests/operations.test.js tests/firestore-quota.test.js tests/deferred-command.test.js",
    "assets:webp": "python scripts/assets/optimize-images.py --write",
    "assets:audit": "python scripts/assets/optimize-images.py",
    "verify:math": "node scripts/game/verify-math.js",
    "verify:sessions": "node scripts/game/verify-sessions.js",
    "export:model": "node scripts/game/export-model.js",
    "cloud:build": "node scripts/admin/cloud-local.js build",
    "test:cloud": "node scripts/admin/cloud-local.js test",
    "cloud:handoff": "node scripts/admin/cloud-handoff.js",
    "cloud:control": "node scripts/admin/cloud-control.js",
    "wallet:recovery": "node scripts/admin/wallet-recovery.js",
    "test:recovery": "node scripts/admin/cloud-local.js recovery-test",
    "monitor:build": "node scripts/admin/cloud-local.js monitor-build",
    "test:monitor": "node scripts/admin/cloud-local.js monitor-test",
    "validation:start": "node scripts/admin/validation-server.js",
    "validation:test": "node --test tests/local-wallet.test.js tests/wallet-client.test.js tests/spin-controls.test.js tests/spin-shortcut.test.js",
    "test:reset": "node scripts/admin/cloud-local.js reset-test",
    "test:experience": "node scripts/qa/reel-experience.js",
    "test:dealer": "node scripts/qa/dealer-resources.js",
    "test:startup": "node scripts/qa/startup-resources.js",
    "test:numbers": "node scripts/qa/number-rendering.js",
    "verify": "node scripts/qa/verify.js",
    "verify:full": "node scripts/qa/verify.js --full",
    "verify:ci": "node scripts/qa/verify.js --ci",
    "test:security": "node scripts/qa/security-smoke.js",
    "test:discord-sdk": "node scripts/qa/discord-sdk.js",
    "testdata:reset": "node scripts/admin/reset-test-data.js"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "protobufjs": false,
    "fsevents": false
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@google-cloud/firestore": "9.4.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "playwright": "1.64.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "@google-cloud/firestore-api": {
      "google-gax": "5.0.4",
      "gcp-metadata": "8.1.2"
    },
    "@discord/embedded-app-sdk": {
      "zod": "4.6.7"
    },
    "undici": "7.30.1"
  }
}
